# Artificial Neural Network (ANN)

```{r}
# 1. Data
train_data_ann <- data.frame(X_train_scaled, LUNG_CANCER = y_train)
test_data_ann  <- data.frame(X_test_scaled, LUNG_CANCER = y_test)

# 2. Calculate dynamic 'a' hidden units: (attributes + classes) / 2
num_attributes <- ncol(X_train_scaled)
num_classes    <- length(levels(y_train))
hidden_a       <- round((num_attributes + num_classes) / 2)

# 3. Fit Artificial Neural Network
# size = hidden_a (8 nodes)
# maxNWts = max weights (increase to avoid limit error)
# maxit = 500 training epochs
ann_model <- nnet(
  LUNG_CANCER ~ .,
  data = train_data_ann,
  size = hidden_a,     # 'a' parameter (~8 hidden nodes)
  decay = 0.0,         # L2 weight decay
  maxit = 500,         # training time = 500 epochs
  MaxNWts = 2000,
  trace = FALSE
)

# 4. Predict & Evaluate
ann_preds <- predict(ann_model, newdata = test_data_ann, type = "class")
ann_preds <- factor(ann_preds, levels = levels(y_test))

conf_matrix_ann <- confusionMatrix(ann_preds, y_test)
print(conf_matrix_ann)
```

