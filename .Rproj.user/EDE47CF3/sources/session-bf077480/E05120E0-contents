# Stochastic Gradient Descent (SGD)

```{r}
# 1. Prepare Data: One-hot encode factor predictors (SGD requires numeric inputs)
# Exclude target from dummy processing
predictors_train <- train_set[, setdiff(names(train_set), "LUNG_CANCER")]
predictors_test  <- test_set[, setdiff(names(test_set), "LUNG_CANCER")]

# Create dummy matrix (one-hot encoding)
dummies <- dummyVars(~ ., data = predictors_train, fullRank = TRUE)
X_train <- predict(dummies, newdata = predictors_train)
X_test  <- predict(dummies, newdata = predictors_test)

# Scale numeric features (Critical for SGD convergence)
X_train_scaled <- scale(X_train)
# Apply train set center and scale parameters to test set
X_test_scaled  <- scale(X_test, 
                        center = attr(X_train_scaled, "scaled:center"), 
                        scale  = attr(X_train_scaled, "scaled:scale"))

# Target vector
y_train <- train_set$LUNG_CANCER
y_test  <- test_set$LUNG_CANCER

# 2. Map Parameters to LiblineaR
# type = 1: L2-regularized L2-loss SVC dual
# type = 2: L2-regularized L1-loss SVC dual (Standard Hinge Loss)
# cost C = 1 / (lambda * N_samples)
lambda_val <- 1e-4
cost_val   <- 1 / (lambda_val * nrow(X_train_scaled))

# 3. Fit Linear SGD/SVM Model
sgd_model <- LiblineaR(
  data = X_train_scaled,
  target = y_train,
  type = 2,              # L1-loss (Hinge) SVM
  cost = cost_val,       # Mapped lambda
  epsilon = 0.001        # Convergence tolerance (epsilon)
)

# 4. Predict & Evaluate
sgd_preds <- predict(sgd_model, newx = X_test_scaled)$predictions
conf_matrix_sgd <- confusionMatrix(sgd_preds, y_test)

print(conf_matrix_sgd)
```

