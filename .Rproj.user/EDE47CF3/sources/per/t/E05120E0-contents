# Bayesian Network (BayesNet)

```{r}
# Define column groups
numeric_cols <- c("HEIGHT", "WEIGHT", "BMI")
factor_cols  <- setdiff(names(train_set), numeric_cols)

# ---------------------------------------------------------
# 1. Discretize Numeric Variables & Factorize Discrete Ones
# ---------------------------------------------------------
# Ensure categorical features are factors
train_bn <- train_set
test_bn  <- test_set

train_bn[factor_cols] <- lapply(train_bn[factor_cols], factor)
test_bn[factor_cols]  <- lapply(test_bn[factor_cols], factor)

# GROUP POOR_PHYS_DAYS SEPARATELY
# Clinically meaningful bins for poor physical health days (0 to 30)
# 0 days (None), 1-13 days (Occasional/Moderate), 14-30 days (Frequent/Severe impairment)
recode_phys_days <- function(x) {
  cut(
    x,
    breaks = c(-Inf, 0, 13, Inf),
    labels = c("None_0", "Occasional_1_13", "Frequent_14_30"),
    right = TRUE
  )
}

train_bn$POOR_PHYS_DAYS <- recode_phys_days(train_set$POOR_PHYS_DAYS)
test_bn$POOR_PHYS_DAYS  <- recode_phys_days(test_set$POOR_PHYS_DAYS)

# Discretize continuous columns in training set (e.g., into 3-4 intervals/quantiles)
# method = "interval" or method = "quantile"
train_discretized <- discretize(train_bn[, numeric_cols], method = "quantile", breaks = 3)
train_bn[, numeric_cols] <- train_discretized

# Apply the same cutpoints from train to test set
for (col in numeric_cols) {
  # Extract cutpoints used in train set
  # (or use base::cut with quantile breaks computed on train_set)
  brks <- quantile(train_set[[col]], probs = seq(0, 1, length.out = 4), na.rm = TRUE)
  brks[1] <- -Inf
  brks[length(brks)] <- Inf
  
  train_bn[[col]] <- cut(train_set[[col]], breaks = brks, include.lowest = TRUE)
  test_bn[[col]]  <- cut(test_set[[col]],  breaks = brks, include.lowest = TRUE)
}

# Ensure all columns in both sets are standard factors with matched levels
for (col in names(train_bn)) {
  train_bn[[col]] <- factor(train_bn[[col]])
  test_bn[[col]]  <- factor(test_bn[[col]], levels = levels(train_bn[[col]]))
}

# ---------------------------------------------------------
# 2. 10-Fold Cross-Validation Loop
# ---------------------------------------------------------
target_node <- "LUNG_CANCER"
bn_cv_acc   <- numeric(10)

for (i in 1:10) {
  val_idx    <- cv_folds[[i]]
  fold_train <- train_bn[-val_idx, ]
  fold_val   <- train_bn[val_idx, ]
  
  # Remove single-level columns if any exist in the fold
  single_level <- sapply(fold_train, function(x) length(unique(x)) < 2)
  if (any(single_level)) {
    fold_train <- fold_train[, !single_level]
    fold_val   <- fold_val[, !single_level]
  }
  
  # Match factor levels
  for (col in names(fold_train)) {
    fold_val[[col]] <- factor(fold_val[[col]], levels = levels(fold_train[[col]]))
  }
  
  # Learn structure and fit parameters
  dag <- hc(fold_train)
  fitted <- bn.fit(dag, data = fold_train, method = "bayes", iss = 1)
  
  # Predict via likelihood weighting
  preds <- predict(fitted, node = target_node, data = fold_val, method = "bayes-lw")
  bn_cv_acc[i] <- mean(preds == fold_val[[target_node]], na.rm = TRUE)
}

cat("BayesNet 10-Fold CV Mean Accuracy:", mean(bn_cv_acc), "\n")

# ---------------------------------------------------------
# 3. Final Model Evaluation on Test Set
# ---------------------------------------------------------
dag_final <- hc(train_bn)
bn_final  <- bn.fit(dag_final, data = train_bn, method = "bayes", iss = 1)
bn_preds  <- predict(bn_final, node = target_node, data = test_bn, method = "bayes-lw")

confusionMatrix(bn_preds, test_bn[[target_node]], positive = "Yes")
```

# Stochastic Gradient Descent (SGD)

```{r}
library(LiblineaR)
library(caret)

# ---------------------------------------------------------
# 1. Recode 0/1 to Valid R Variable Names ("No" / "Yes")
# ---------------------------------------------------------
train_sgd <- train_set
test_sgd <- test_set

if (!all(levels(train_sgd$LUNG_CANCER) %in% c("No", "Yes"))) {
  train_sgd$LUNG_CANCER <- factor(train_sgd$LUNG_CANCER, 
                                  levels = c("0", "1"), 
                                  labels = c("No", "Yes"))
  
  test_sgd$LUNG_CANCER  <- factor(test_sgd$LUNG_CANCER, 
                                  levels = c("0", "1"), 
                                  labels = c("No", "Yes"))
}

# ---------------------------------------------------------
# 2. Configure trainControl
# ---------------------------------------------------------
train_ctrl <- trainControl(
  method = "cv",
  number = 10,
  classProbs = TRUE,
  summaryFunction = twoClassSummary,
  savePredictions = "final",
  verboseIter = FALSE
)

# ---------------------------------------------------------
# 3. Train Regularized Logistic Regression (SGD Equivalent)
# ---------------------------------------------------------
set.seed(42)
sgd_model <- train(
  LUNG_CANCER ~ .,
  data = train_sgd,
  method = "regLogistic",
  preProcess = c("center", "scale"),
  tuneGrid = expand.grid(
    cost = 1 / (1e-4 * nrow(train_sgd)),
    loss = "L2_dual",
    epsilon = 0.01
  ),
  trControl = train_ctrl,
  metric = "ROC"
)

# ---------------------------------------------------------
# 4. Predict & Evaluate
# ---------------------------------------------------------
sgd_preds <- predict(sgd_model, newdata = test_sgd)

# positive = "Yes" matches the second factor level
conf_matrix_sgd <- confusionMatrix(sgd_preds, test_sgd$LUNG_CANCER, positive = "Yes")
print(conf_matrix_sgd)
```

