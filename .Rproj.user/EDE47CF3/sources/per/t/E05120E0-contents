# Logistic Model Tree (LMT)
A Model-Based Recursive Partitioning Tree with Linear Regression is the alternative to Weka's LMT.

```{r warning=FALSE}
library(partykit)

cv_acc <- numeric(10)
cv_auc <- numeric(10)

formula_str <- as.formula(paste("LUNG_CANCER ~", paste(setdiff(names(train_set), "LUNG_CANCER"), collapse = " + ")))

for (i in 1:10) {
  val_idx   <- cv_folds[[i]]
  fold_train <- train_sgd[-val_idx, ]
  fold_val   <- train_sgd[val_idx, ]
  
  # Fit glmtree on fold_train
  tree_fit <- glmtree(
    formula_str,
    data = fold_train,
    family = binomial,
    alpha = 0.05,
    minsize = 30
  )
  
  # Predict probabilities and classes
  val_probs <- predict(tree_fit, newdata = fold_val, type = "response")
  val_preds <- factor(ifelse(val_probs >= 0.5, "Yes", "No"), levels = c("No", "Yes"))
  
  cv_acc[i] <- mean(val_preds == fold_val$LUNG_CANCER)
  cv_auc[i] <- as.numeric(roc(response = fold_val$LUNG_CANCER, predictor = val_probs, quiet = TRUE)$auc)
}

cat("10-Fold CV Mean Accuracy:", mean(cv_acc), "\n")
cat("10-Fold CV Mean ROC-AUC:", mean(cv_auc), "\n")

# Fit on full train set and evaluate on test set
