benchmark_df,
caption = "<b>Benchmark Performance Summary across Machine Learning Models</b>",
col.names = c("Model Architecture", "Accuracy", "Precision", "Recall"),
align = c("l", "c", "c", "c")
)
# Print the table
print(kable_table)
