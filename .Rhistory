library(rotationForest)
library(caret)
library(pROC)
# ---------------------------------------------------------
# 1. Prepare Features & Integer Targets
# ---------------------------------------------------------
# One-hot encode predictors
x_train_mat <- model.matrix(LUNG_CANCER ~ . - 1, data = train_set)
x_test_mat  <- model.matrix(LUNG_CANCER ~ . - 1, data = test_set)
# Remove zero-variance dummy columns if any exist
nzv <- nearZeroVar(x_train_mat)
if (length(nzv) > 0) {
x_train_mat <- x_train_mat[, -nzv, drop = FALSE]
x_test_mat  <- x_test_mat[, colnames(x_train_mat), drop = FALSE]
}
# rotationForest requires y to be numeric/integer 0 and 1
# (Convert factor "No"/"Yes" -> integer 0 and 1)
y_train_num <- ifelse(train_set$LUNG_CANCER == "Yes", 1L, 0L)
y_test_num  <- ifelse(test_set$LUNG_CANCER == "Yes", 1L, 0L)
# ---------------------------------------------------------
# 2. 10-Fold Cross-Validation Loop
# ---------------------------------------------------------
cv_acc <- numeric(10)
cv_auc <- numeric(10)
# Ensure K satisfies (Total Features / K) >= 3
num_features <- ncol(x_train_mat)
K_param <- min(3, max(2, floor(num_features / 3)))
L_param <- 25  # Number of trees
for (i in 1:10) {
val_idx <- cv_folds[[i]]
# Ensure clean numeric data frames
fold_x_tr <- as.data.frame(x_train_mat[-val_idx, , drop = FALSE])
fold_y_tr <- y_train_num[-val_idx]
fold_x_val <- as.data.frame(x_train_mat[val_idx, , drop = FALSE])
fold_y_val <- y_train_num[val_idx]
# Fit Rotation Forest using integer target
rf_fit <- rotationForest(
x = fold_x_tr,
y = fold_y_tr,
K = K_param,
L = L_param
)
# Predict probabilities for class 1 ("Yes")
val_probs <- predict(rf_fit, fold_x_val)
if (is.matrix(val_probs)) {
val_probs <- val_probs[, 2]
}
# Convert probabilities to factors matching test_set$LUNG_CANCER
val_preds <- factor(ifelse(val_probs >= 0.5, "Yes", "No"), levels = c("No", "Yes"))
actual_val <- factor(ifelse(fold_y_val == 1, "Yes", "No"), levels = c("No", "Yes"))
cv_acc[i] <- mean(val_preds == actual_val, na.rm = TRUE)
cv_auc[i] <- as.numeric(roc(response = actual_val, predictor = val_probs, quiet = TRUE)$auc)
}
cat("Rotation Forest 10-Fold CV Mean Accuracy:", mean(cv_acc), "\n")
cat("Rotation Forest 10-Fold CV Mean ROC-AUC:", mean(cv_auc), "\n")
# ---------------------------------------------------------
# 3. Final Model Evaluation on Test Set
# ---------------------------------------------------------
final_rf <- rotationForest(
x = as.data.frame(x_train_mat),
y = y_train_num,
K = K_param,
L = L_param
)
test_probs <- predict(final_rf, as.data.frame(x_test_mat))
if (is.matrix(test_probs)) {
test_probs <- test_probs[, 2]
}
test_preds_rotf <- factor(ifelse(test_probs >= 0.5, "Yes", "No"), levels = c("No", "Yes"))
conf_matrix_rot <- confusionMatrix(test_preds_rotf, test_set$LUNG_CANCER, positive = "Yes")
print(conf_matrix_rot)
