# Extract discretized training set
train_discretized <- mdlp_model$Disc.data
# Apply the same cuts learned from training set onto testing set
# (Prevents data leakage from test set)
test_discretized <- apply_mdlp_cuts(test_set[, AGE, drop=FALSE], mdlp_model$cutp)
