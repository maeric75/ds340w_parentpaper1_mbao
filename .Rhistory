plot(roc_rt,  col = "maroon",   add = TRUE)
# Add Legend with Model Names
legend("bottomright",
legend = c("Naive Bayes", "BayesNet", "SGD", "Linear SVM",
"Logistic Regression", "ANN", "KNN", "Decision Tree", "LMT", "Random Forest", "Random Tree"),
col = c("red", "blue", "green", "purple", "orange", "brown", "pink", "darkcyan", "darkgreen", "lightgreen", "maroon"),
lwd = 2, cex = 0.8)
