sgd_model <- train(
LUNG_CANCER ~ .,
data = train_sgd,
method = "regLogistic",
preProcess = c("center", "scale"),
tuneGrid = expand.grid(
cost = 1 / (1e-4 * nrow(train_sgd)),
loss = "L2_dual",
epsilon = 0.01
),
trControl = train_ctrl,
metric = "ROC"
)
